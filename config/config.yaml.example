telegram:

  bot_token: "900000:A********F0"
  check_interval: 300 # 检查间隔，单位：秒

feeds:
  - name: "xiaobaiup"
    url: "http://127.0.0.1/rss.xml"
    first_push: false  # 设置为 false 则第一次启动时不推送现有文章
    # article_expiration_duration_hours: 720 # 超过指定时间的旧文章不推送（文章有发布时间时），默认推送
    channels:
      - "@test_push"
      - "@test_push2"

    # 消息默认  为空则默认 {title}\n\n{link}
    template: |
      📰 *{title}*

      {description}

      🔗 [阅读原文]({link})

  # 全文快照 feed：抓原文发布到 Telegraph，{telegraph} 为快照链接（失败降级为原文链接）
  - name: "special-feed"
    url: "https://example.com/rss"
    channels:
      - "@test_push"
    snapshot: telegraph  # 可选，缺省不启用；只能填 telegraph，其他值启动报错
    # snapshot_source 正文来源（可选，需先启用 snapshot，否则校验报错）：
    #   缺省/page：请求 item.Link 原文，readability 提取正文后建页
    #   feed：直接用 RSS item 正文（见下方 fulltext-feed 示例）
    template: |
      📰 *{title}*

      🔗 [快照]({telegraph})
      🌐 [原文]({link})

  # 全文输出型 RSS 源（snapshot_source: feed）：正文取 RSS item 的
  # content:encoded（空则退回 description），不抓原文、不过 readability。
  # 适合源本身输出全文、或原文有反爬/需 JS 渲染/readability 洗坏正文的场景；
  # 要求正文里的图片是绝对 http(s) 地址，相对/data: 图会被丢弃
  - name: "fulltext-feed"
    url: "https://example.com/fulltext.xml"
    channels:
      - "@test_push"
    snapshot: telegraph
    snapshot_source: feed  # 只能填 page/feed；摘要型源误配会因正文过短降级为原文链接
    template: |
      📰 *{title}*

      🔗 [快照]({telegraph})
      🌐 [原文]({link})

  # 图片推送 feed（media: photo，issue #13）：图片为主体，template 渲染结果为图片下方 caption；
  # 图片来源 enclosure > 正文/摘要中的第一张图（最多尝试 3 个候选），由本程序下载后上传，
  # 需主机能访问图床；无图/下载失败/格式尺寸不符（GIF、SVG、宽+高>10000、长宽比>20、
  # 短边<50px 小图、>10MB）时该条自动回退普通文本推送
  - name: "photo-feed"
    url: "https://example.com/photo.xml"
    channels:
      - "@test_push"
    media: photo  # 可选，缺省不启用；只能填 photo，其他值启动报错
    # photo_slices 相册切片上限（可选，仅在 media: photo 时允许配置，否则启动报错）：
    # 长图切片相册最多展示的片数；缺省 0 = 默认 10；显式值只能填 1-10（1 = 单图预览顶部切片；相册硬上限 10）
    # photo_slices: 10
    # photo_overlimit 超限长图行为（可选，仅在 media: photo 时允许配置，否则启动报错）：
    #   document（默认）= 切不完整图的超限长图整图发文件附件（完整但无内联预览）
    #   crop = 改发顶部 photo_slices 片切片相册预览，caption 注明「（长图过长，已截断）」
    # photo_overlimit: document
    template: |
      📰 *{title}*

      🔗 [阅读原文]({link})
