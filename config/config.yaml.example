telegram:

  bot_token: "900000:A********F0"
  check_interval: 300 # 检查间隔，单位：秒

feeds:
  - name: "xiaobaiup"
    url: "http://127.0.0.1/rss.xml"
    first_push: false  # 设置为 false 则第一次启动时不推送现有文章
    # article_expiration_duration_hours: 720 # 超过指定时间的旧文章不推送（文章有发布时间时），默认推送
    channels:
      - "@test_push"
      - "@test_push2"

    # 消息默认  为空则默认 {title}\n\n{link}
    template: |
      📰 *{title}*

      {description}

      🔗 [阅读原文]({link})

  # 全文快照 feed：抓原文发布到 Telegraph，{telegraph} 为快照链接（失败降级为原文链接）
  - name: "special-feed"
    url: "https://example.com/rss"
    channels:
      - "@test_push"
    snapshot: telegraph  # 可选，缺省不启用；其他值启动报错
    template: |
      📰 *{title}*

      🔗 [快照]({telegraph})
      🌐 [原文]({link})
